<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/volt_bg"
android:fillViewport="true">
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:paddingStart="20dp"
android:paddingEnd="20dp"
android:paddingTop="28dp"
android:paddingBottom="32dp">
<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:letterSpacing="0.12"
android:text="VOLT · TUNER"
android:textAllCaps="true"
android:textColor="@color/volt_muted"
android:textSize="11sp" />
<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="6dp"
android:text="realme 9 Pro 5G"
android:textColor="@color/volt_fg"
android:textSize="26sp"
android:textStyle="bold" />
<TextView
android:id="@+id/status"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="8dp"
android:layout_marginBottom="12dp"
android:text="Sprawdzam Shizuku…"
android:textColor="@color/volt_signal"
android:textSize="14sp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_shizuku"
android:layout_width="match_parent"
android:layout_height="52dp"
android:text="Połącz Shizuku"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_grant"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Nadaj WRITE_SECURE_SETTINGS"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<TextView
style="@style/VoltSection"
android:text="Tuner Realme" />
<TextView
style="@style/VoltHint"
android:text="Te same przełączniki co wcześniej: Smart 5G, DNS, APN, oszczędzanie. Shizuku zapisuje je w systemie." />
<!-- Przełącznik ładowania -->
<com.google.android.material.switchmaterial.SwitchMaterial
android:id="@+id/switch_charging_mode"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="8dp"
android:layout_marginBottom="8dp"
android:paddingStart="4dp"
android:paddingEnd="4dp"
android:text="Super szybkie ładowanie"
android:textColor="@color/volt_fg"
android:textSize="16sp"
android:checked="true" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_apply_all"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Zastosuj cały tuner"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_smart5g"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Wyłącz Inteligentne 5G"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_network_auto"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Typ sieci: 5G/4G auto (NSA)"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_data_saver"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Wyłącz oszczędzanie danych"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_always_on"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Radio: nie usypiaj RRC"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_battery"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Bateria: nie tnij radia"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_dual"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Dwukanałowe / Wi-Fi (otwórz)"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_sim"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Internet na karcie z 5G (otwórz)"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<TextView
style="@style/VoltSection"
android:text="Prywatny DNS" />
<TextView
style="@style/VoltHint"
android:text="Omija wolny DNS operatora. Cloudflare jest domyślny w „całym tunerze”." />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_dns_cf"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Cloudflare · one.one.one.one"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_dns_google"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Google · dns.google"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_dns_quad9"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Quad9 · dns.quad9.net"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_dns_adguard"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="AdGuard · dns.adguard-dns.com"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_dns_off"
style="@style/Widget.Material3.Button.TextButton"
android:layout_width="match_parent"
android:layout_height="48dp"
android:layout_marginTop="4dp"
android:text="Wyłącz Prywatny DNS"
android:textAllCaps="false" />
<TextView
style="@style/VoltSection"
android:text="APN operatora" />
<TextView
style="@style/VoltHint"
android:text="Protokół IPv4/IPv6 na aktywnej karcie, plus gotowce Play / Orange / Plus / T-Mobile." />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_apn_ipv6"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="APN: IPv4/IPv6 na bieżącej karcie"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_apn_play"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Wgraj APN Play"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_apn_orange"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Wgraj APN Orange / nju"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_apn_plus"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Wgraj APN Plus"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_apn_tmobile"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Wgraj APN T-Mobile / Heyah"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_apn_open"
style="@style/Widget.Material3.Button.TextButton"
android:layout_width="match_parent"
android:layout_height="48dp"
android:layout_marginTop="4dp"
android:text="Otwórz listę APN"
android:textAllCaps="false" />
<TextView
style="@style/VoltSection"
android:text="VoLTE / radio" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_volte"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Włącz VoLTE"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_vowifi"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Włącz VoWiFi"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<com.google.android.material.button.MaterialButton
android:id="@+id/btn_radioinfo"
style="@style/Widget.Material3.Button.TonalButton"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginTop="8dp"
android:text="Otwórz RadioInfo / menu testowe"
android:textAllCaps="false"
app:cornerRadius="12dp" />
<TextView
android:id="@+id/log"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="20dp"
android:fontFamily="monospace"
android:text="Dziennik poleceń\n"
android:textColor="@color/volt_muted"
android:textSize="12sp" />
</LinearLayout>
</ScrollView>
